{
  "name": "recall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "dev:server": "node --watch server/src/index.js",
    "dev:local": "node scripts/local.js",
    "build": "VITE_DEMO_MODE=false vite build",
    "start": "node server/src/index.js",
    "test": "node --test --test-concurrency=1 server/test/*.test.js",
    "seed": "node server/src/seed.js",
    "healthcheck": "node scripts/healthcheck.js",
    "test:integration": "RUN_INTEGRATION=1 node --test --test-concurrency=1 server/test/integration.test.js",
    "build:preview": "VITE_DEMO_MODE=true vite build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.18.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "sharp": "^0.34.4",
    "sonner": "^2.0.7",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.4",
    "vite": "^7.1.6"
  }
}
