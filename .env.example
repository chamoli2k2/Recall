PORT=4000
MONGODB_URI=mongodb://localhost:27017/recall?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:4173
NODE_ENV=development
# Same-origin is recommended in production. Set only for a separately hosted frontend.
VITE_API_URL=
# Set to 1 only when behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Readiness (GET /api/ready) waits at most this long for a MongoDB ping before returning 503. Range 100–10000.
READINESS_TIMEOUT_MS=2000
# Payments. With no Razorpay keys the online option simply is not offered, and the UPI-transfer flow
# carries the product on its own. Once the gateway is live, MANUAL_PAYMENT=off retires the old flow
# without a redeploy — the checkout page only ever shows what the server says is usable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to the secret you entered when creating the webhook in the Razorpay dashboard, and point
# the webhook at POST /api/premium/webhook/razorpay for the payment.captured and payment.failed events.
RAZORPAY_WEBHOOK_SECRET=
MANUAL_PAYMENT=on
# Used only by scripts/healthcheck.js, which runs on an external machine — not by the server itself.
# Point it at the deployed liveness endpoint, e.g. https://recall.example.com/api/health
HEALTHCHECK_URL=
